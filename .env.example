# Supabase (browser — Vite exposes only VITE_ prefixed vars to the client bundle)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase (server — used by the /api/chat serverless function to verify the
# caller's JWT and enforce per-user daily caps under their RLS context).
# Optional: the function falls back to the VITE_ vars above if these are unset.
# On Vercel, set these in Project Settings → Environment Variables.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# Anthropic — server-only. NEVER expose this in the browser.
# Only the /api/chat serverless function reads it.
ANTHROPIC_API_KEY=your-api-key-here
